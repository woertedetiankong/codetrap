{
  "name": "codetrap",
  "version": "0.1.9",
  "description": "Capture and retrieve coding pitfalls so AI doesn't repeat mistakes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woertedetiankong/codetrap.git"
  },
  "bugs": {
    "url": "https://github.com/woertedetiankong/codetrap/issues"
  },
  "homepage": "https://github.com/woertedetiankong/codetrap#readme",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "mcp",
    "memory",
    "sqlite"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "bin",
    "src/commands",
    "src/db",
    "src/domain",
    "src/lib",
    "src/mcp",
    "src/web",
    "src/index.ts",
    "src/mcp-server.ts",
    "plugins",
    "benchmarks",
    ".agents/plugins/marketplace.json",
    "scripts",
    "tsconfig.browser.json",
    "docs/installation.md",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codetrap": "bin/codetrap"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "bun run build:web && bun run src/index.ts",
    "install:cli": "ln -sf \"$PWD/bin/codetrap\" \"$(bun pm bin -g)/codetrap\"",
    "build:release": "bun run scripts/build-release.ts",
    "release:preflight": "bun run scripts/release-preflight.ts",
    "check:release-version": "bun run scripts/check-release-version.ts",
    "eval:dogfood": "bun run scripts/dogfood-eval.ts",
    "eval:search-policy": "bun run scripts/search-policy-sweep.ts",
    "benchmark:retrieval": "bun run scripts/public-retrieval-benchmark.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.browser.json",
    "build": "bun run scripts/build-standalone.ts ./src/index.ts dist/codetrap && bun run scripts/build-standalone.ts ./src/mcp-server.ts dist/codetrap-serve",
    "build:cli": "bun run scripts/build-standalone.ts ./src/index.ts dist/codetrap",
    "build:serve": "bun run scripts/build-standalone.ts ./src/mcp-server.ts dist/codetrap-serve",
    "build:web": "bun run scripts/build-web.ts",
    "check:web": "bun run scripts/build-web.ts --check",
    "prepack": "bun run check:web"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "1.60.0",
    "typescript": "7.0.2"
  }
}
